" --- diffs and git ---------------------------------------------------------
call s:hi('DiffAdd',     s:green,  '', '')
call s:hi('DiffChange',  s:orange, '', '')
call s:hi('DiffDelete',  s:red,    '', '')
call s:hi('DiffText',    s:yellow, '', 'bold')
