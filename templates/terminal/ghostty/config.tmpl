# bothy hands this file to ghostty with --config-file, so your own
# ~/.config/ghostty/config is neither read nor written.
#
# The palette is written out here rather than referenced as `theme = <name>`.
# Ghostty's theme *lookup* paths are not relocatable — a named theme is hunted
# for in ~/.config/ghostty/themes and /usr/share/ghostty/themes — so naming one
# would send it straight back into the directory this file exists to avoid.
# Verified: ghostty +validate-config --config-file=<this> exits 0.

background = {{ .Theme.Bg }}
foreground = {{ .Theme.Fg }}
cursor-color = {{ .Theme.Comment }}
cursor-text = {{ .Theme.Bg }}
selection-background = {{ .Theme.Selection }}
selection-foreground = {{ .Theme.Fg }}

palette = 0={{ .Theme.Bg }}
palette = 1={{ .Theme.Red }}
palette = 2={{ .Theme.Green }}
palette = 3={{ .Theme.Yellow }}
palette = 4={{ .Theme.Purple }}
palette = 5={{ .Theme.Pink }}
palette = 6={{ .Theme.Cyan }}
palette = 7={{ .Theme.Fg }}
palette = 8={{ .Theme.Comment }}
palette = 9={{ .Theme.Red }}
palette = 10={{ .Theme.Green }}
palette = 11={{ .Theme.Yellow }}
palette = 12={{ .Theme.Purple }}
palette = 13={{ .Theme.Pink }}
palette = 14={{ .Theme.Cyan }}
palette = 15={{ .Theme.Fg }}
{{ if .Font }}
font-family = {{ .Font }}
{{- end }}

# Make URLs clickable.
link-url = true
