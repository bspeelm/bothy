# prepend_keymap wins over the defaults; anything not listed here is untouched.
# As with init.lua, a binding is only written when its plugin is installed —
# otherwise pressing the key is a silent no-op.
{{- if index .Plugins "smart-enter" }}

[[mgr.prepend_keymap]]
on   = "l"
run  = "plugin smart-enter"
desc = "Enter the child directory, or open the file"
{{- end }}
{{- if index .Plugins "chmod" }}

[[mgr.prepend_keymap]]
on   = [ "c", "m" ]
run  = "plugin chmod"
desc = "Chmod on selected files"
{{- end }}
