# Sourced from ~/.bashrc.d/, which Fedora's stock ~/.bashrc already loops over.
# Living in its own file rather than appended to ~/.bashrc means uninstall is a
# single file removal with nothing to unpick.

# Fedora ships nano-default-editor, which exports EDITOR=nano from
# /etc/profile.d. That is what Yazi, lazygit and git shell out to, so it has to
# be overridden here rather than assumed.
if command -v {{ .EditorBin }} >/dev/null 2>&1; then
    export EDITOR={{ .EditorBin }}
elif command -v vi >/dev/null 2>&1; then
    export EDITOR=vi
fi
export VISUAL="$EDITOR"

# Compact prompt — a 40%-wide side pane cannot spare "user@host". This is a
# surgical edit of whatever PS1 is already set rather than a fresh one, so the
# toolbox ⬢ marker and any shell-integration wrappers survive:
#   ⬢ [user@host dir]$   ->   ⬢ dir$
if [ -n "$PS1" ]; then
    PS1="${PS1//\\u@\\h /}"
    PS1="${PS1//\[\\W\]/\\W}"
fi

# `bothy` launches the workspace and `bothy attach` reattaches. Both are the
# binary itself — there is no shell function here to go stale, and nothing that
# behaves differently on the host than it does inside a container.
#
# BOTHY_PROJECT_DIR pins it to one directory, if you would rather it did not
# follow $PWD.
